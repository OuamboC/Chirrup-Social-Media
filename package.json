{
  "name": "fsd_chirrup_server",
  "version": "1.0.0",
  "description": "The Chirrup API for the 23/24 Full Stack Web Development assignment",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-sqlite-on-linux.js",
    "start": "node server.js",
    "extension": "mocha ./tests/extension.tests.js --reporter spec --log-level=warn --timeout 10000",
    "wipe": "mocha ./tests/database.refresh.js --reporter spec --log-level=warn --timeout 10000",
    "test": "mocha ./tests/test.*.js --reporter spec --log-level=warn --timeout 10000",
    "dev": "nodemon server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ash-williams/fsd_chirrup_server.git"
  },
  "keywords": [
    "chirrup",
    "api",
    "assignment",
    "full",
    "stack",
    "web"
  ],
  "author": "Ash Williams",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ash-williams/fsd_chirrup_server/issues"
  },
  "homepage": "https://github.com/ash-williams/fsd_chirrup_server#readme",
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  },
  "dependencies": {
    "bad-words": "^3.0.4",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "joi": "^17.13.3",
    "mocha": "^11.7.5",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10",
    "sqlite3": "^6.0.1"
  }
}
